# Copy this file to .env.local and fill in your keys. Never commit .env.local
# or paste keys into chats, emails or issues.
# Without keys the app still runs: finished answers open the demo feedback.

# Speech-to-text: https://console.deepgram.com (Settings → API Keys)
DEEPGRAM_API_KEY=

# Claude: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Only needed if your Claude key isn't scoped to one workspace (find the ID on the Workspaces page)
ANTHROPIC_WORKSPACE_ID=

# Models (defaults shown)
HAKKIRI_MAIN_MODEL=claude-sonnet-5
HAKKIRI_FAST_MODEL=claude-haiku-5-5

# Set to 1 to run the full record → score flow offline with sample results (no keys, no cost)
HAKKIRI_MOCK_AI=

# Interviewer voice: https://elevenlabs.io/app/settings/api-keys
# Without it (or in test mode) the browser's own voice is used.
ELEVENLABS_API_KEY=
# A voice per difficulty (defaults: Sarah, George, Daniel). Voice IDs from the ElevenLabs Voice Library.
ELEVENLABS_VOICE_EASY=
ELEVENLABS_VOICE_MEDIUM=
ELEVENLABS_VOICE_HARD=
# Set to 1 only on an ElevenLabs enterprise plan with zero retention
ELEVENLABS_ZERO_RETENTION=
# The ElevenLabs model (default eleven_flash_v2_5: cheapest and quickest)
# ELEVENLABS_MODEL=

# Where practice data is saved (default: .hakkiri-data in the project). HAKKIRI_SAVE=off keeps everything in memory.
# HAKKIRI_DATA_DIR=
# HAKKIRI_SAVE=

# Set to 1 only when Hakkiri runs behind a proxy you control (Vercel, Cloudflare, nginx): the
# per-minute limits then count callers by the forwarded address. Off, every caller counts as one.
HAKKIRI_TRUST_PROXY=

# Limits (defaults shown; 0 turns one off). Until accounts land they cover the whole app.
HAKKIRI_DAILY_MINUTES=120
HAKKIRI_DAILY_SPEND_USD=5
HAKKIRI_MONTHLY_SPEND_USD=60

# Price overrides for the usage estimates, only if your rates differ
# (dollars per million tokens, per minute of audio, per 1,000 characters)
# HAKKIRI_PRICE_SONNET_IN=2
# HAKKIRI_PRICE_SONNET_OUT=10
# HAKKIRI_PRICE_HAIKU_IN=1
# HAKKIRI_PRICE_HAIKU_OUT=5
# HAKKIRI_PRICE_HAIKU5_IN=0.1
# HAKKIRI_PRICE_HAIKU5_OUT=0.5
# HAKKIRI_PRICE_OPUS_IN=5
# HAKKIRI_PRICE_OPUS_OUT=25
# HAKKIRI_PRICE_DEEPGRAM_MIN=0.0043
# HAKKIRI_PRICE_ELEVENLABS_1K=0.05

# Error alerts: the first of each problem is sent here (then at most every 30 minutes).
# A Slack, Discord or Teams incoming webhook, and/or email through Resend (resend.com).
ALERT_WEBHOOK_URL=
RESEND_API_KEY=
ALERT_EMAIL_TO=
# Must be an address on a domain you've verified in Resend
ALERT_EMAIL_FROM=

# Launch switch: 1 hides the demos, test mode, developer messages and costs. Set both.
HAKKIRI_LAUNCH=
NEXT_PUBLIC_HAKKIRI_LAUNCH=

# Beta switch: 1 runs the launched app as a closed, free beta. Each tester gets a
# login from the team (no sign-up) and 10 hours of practice a month, reset on
# the 1st (HAKKIRI_BETA_MINUTES overrides it, in minutes), no daily cap, spend limits $25/day and
# $200/month unless set above, nothing is for sale, the public pages say "free while
# we're in beta", and a Feedback button asks questions about the screen the
# tester is on and sends the answers to the alerts webhook or email above.
# Implies the launch switch. Set both.
HAKKIRI_BETA=
NEXT_PUBLIC_HAKKIRI_BETA=
HAKKIRI_BETA_MINUTES=

# Database: MongoDB Atlas connection string
MONGODB_URI=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin Authorization
ADMIN_SECRET_KEY=
ADMIN_EMAILS=

# Later: payments
STRIPE_SECRET_KEY=
